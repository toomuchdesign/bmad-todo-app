+
+/**
+ * Creates a new todo row and maps it to the API contract shape.
+ */
+export async function createTodoInDatabase({
+  text,
+}: {
+  text: string;
+}): Promise<Todo> {
+  const db = getDb();
+  const now = new Date();
+
+  const [row] = await db
+    .insert(todos)
+    .values({
+      id: randomUUID(),
+      text,
+      completed: false,
+      createdAt: now,
+      updatedAt: now,
+      deletedAt: null,
+    })
+    .returning();
+
+  if (!row) {
+    throw new Error("Todo insert did not return a row");
+  }
+
+  return mapTodoRowToApiTodo(row);
 }
